<!--
  Query profile for a small ClickHouse, from plausible/community-edition
  default-profile-low-resources-overrides.xml (MIT). Raise max_threads if you
  give the service more vCPUs and dashboards on large sites feel slow.
-->
<clickhouse>
    <profiles>
        <default>
            <max_threads>1</max_threads>
            <max_block_size>8192</max_block_size>
            <max_download_threads>1</max_download_threads>
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>
            <log_query_threads>0</log_query_threads>
        </default>
    </profiles>
</clickhouse>
